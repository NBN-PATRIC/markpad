<Window x:Class="MarkPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MarkPad"
        Height="820" Width="1280"
        MinHeight="420" MinWidth="640"
        Background="#1e1e1e"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#1e1e1e" />
        <Border x:Name="Splash" Background="#1e1e1e">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="MarkPad"
                           Foreground="#dadada"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SplashText"
                           Text="iniciando..."
                           Foreground="#666666"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
