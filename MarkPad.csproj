<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MarkPad</AssemblyName>
    <RootNamespace>MarkPad</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>MarkPad</Product>
    <Company>NBN Telecom</Company>
    <Description>Leitor/editor de Markdown com trava de edicao</Description>
    <Copyright>Copyright (c) 2026 NBN Telecom; Copyright (c) 2026 Patric Farias</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- nao arrastar os .xml de documentacao dos pacotes para a pasta publicada -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!--
    A interface e embutida no assembly, para o executavel publicado ser um
    arquivo unico de verdade. No build de desenvolvimento a pasta web/ tambem
    e copiada ao lado do exe: quando ela existe, o app serve dali e basta
    recompilar (ou nem isso, via dev/preview.html) para ver as mudancas.
  -->
  <ItemGroup>
    <EmbeddedResource Include="web\**\*" />
    <Content Include="web\**\*" Condition="'$(PublishSingleFile)' != 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

