<?xml version="1.0" encoding="utf-8"?>
<!--
  A config global do usuario esta com <packageSources> vazio, entao o restore
  falha com NU1100. Este arquivo vale so para esta pasta e nao altera nada
  fora do projeto.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
